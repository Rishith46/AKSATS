from datetime import date

from fastapi import APIRouter, Depends, HTTPException, Query
from sqlalchemy import select
from sqlalchemy.orm import Session

from app.deps import get_db, require_permission
from app.models.access import User
from app.models.candidates import (Candidate, CandidateExperience, CandidateRestriction,
                                   CandidateSkill, Skill, TitleMapping)
from app.models.jobs import Job, JobSkill
from app.models.system import MatchConfig
from app.visa import OUTSIDE_US
from app.services.matching import (DEFAULT_WEIGHTS, GATE_RATIO, NOT_SCORED, RECENT_YEARS, combine,
                                   experience_gate, experience_score, location_score, norm_title,
                                   recommend, skills_assessment, title_score, visa_score)

router = APIRouter(prefix="/jobs", tags=["matching"])


@router.get("/{jid}/matches")
def matches(jid: int, limit: int = 50, recent_years: int = Query(RECENT_YEARS, ge=1, le=15),
            db: Session = Depends(get_db),
            user: User = Depends(require_permission("search.use"))):
    job = db.get(Job, jid)
    if not job:
        raise HTTPException(status_code=404, detail="Job not found")
    this_year = date.today().year

    cfg = db.scalar(select(MatchConfig).where(MatchConfig.is_active.is_(True)))
    weights, source = dict(DEFAULT_WEIGHTS), "built-in defaults"
    if cfg and cfg.weights and set(cfg.weights) == set(DEFAULT_WEIGHTS):
        weights, source = dict(cfg.weights), f"match_configs: {cfg.name}"

    rows = db.execute(select(Skill.name, JobSkill.is_required, JobSkill.min_years)
                      .join(JobSkill, JobSkill.skill_id == Skill.id)
                      .where(JobSkill.job_id == jid).order_by(Skill.name)).all()
    req = [(n, m) for n, r, m in rows if r]
    pref = [(n, m) for n, r, m in rows if not r]

    cands = db.scalars(select(Candidate).where(Candidate.archived_at.is_(None),
                                               Candidate.merged_into_id.is_(None))).all()
    ids = [c.id for c in cands]

    have: dict[int, dict] = {i: {} for i in ids}
    for cid, name, ev, yrs, last in db.execute(
            select(CandidateSkill.candidate_id, Skill.name, CandidateSkill.evidence,
                   CandidateSkill.years, CandidateSkill.last_used_year)
            .join(Skill, Skill.id == CandidateSkill.skill_id)
            .where(CandidateSkill.candidate_id.in_(ids))).all():
        have[cid][name] = {"evidence": ev, "years": yrs, "last_year": last}
    titles: dict[int, list[str]] = {i: [] for i in ids}
    for cid, t in db.execute(select(CandidateExperience.candidate_id, CandidateExperience.title)
                             .where(CandidateExperience.candidate_id.in_(ids))).all():
        titles[cid].append(t)
    restr: dict[int, list[dict]] = {i: [] for i in ids}
    for r in db.scalars(select(CandidateRestriction).where(CandidateRestriction.candidate_id.in_(ids))).all():
        restr[r.candidate_id].append({"type": r.restriction_type, "blocking": r.is_blocking})

    mappings = {}
    for a, b, rel in db.execute(select(TitleMapping.title_a, TitleMapping.title_b,
                                       TitleMapping.relatedness)).all():
        mappings[frozenset((norm_title(a), norm_title(b)))] = float(rel)

    results = []
    excluded = []
    for c in cands:
        if c.visa_status == OUTSIDE_US:
            excluded.append({"candidate_id": c.id, "full_name": c.full_name,
                             "reason": "Indian Candidate: in India, not eligible for US-based roles"})
            continue
        mine = have[c.id]
        r_score, r_sum, r_rows = skills_assessment(req, mine, this_year, recent_years)
        p_score, p_sum, p_rows = skills_assessment(pref, mine, this_year, recent_years)
        signals = {
            "required_skills": (r_score, r_sum),
            "preferred_skills": (p_score, p_sum),
            "relevant_experience": experience_score(job.required_experience_years, c.total_experience_years),
            "job_title": title_score(job.title, titles[c.id], mappings),
            "location": location_score(job.location, job.work_mode, c.location),
            "visa": visa_score(job.visa_requirements, c.visa_status),
        }
        score, coverage, breakdown = combine(weights, signals)
        total_w = sum(s["weight"] for s in breakdown.values())
        earned = sum(s["weight"] * s["score"] for s in breakdown.values() if s["score"] is not None)
        floor = round(100 * earned / total_w, 1) if total_w else 0.0

        gated, gate_reason = experience_gate(job.required_experience_years, c.total_experience_years, GATE_RATIO)
        missing = [x["skill"] for x in r_rows if x["status"] == "missing"]
        weak = [x["skill"] for x in r_rows if x["status"] in ("listed", "dated", "partial")]
        rec, reasons = recommend(score, coverage, gated, gate_reason, missing, weak)

        results.append({
            "candidate_id": c.id, "full_name": c.full_name, "parse_status": c.parse_status,
            "recommendation": rec, "recommendation_reasons": reasons,
            "experience_gate": {"blocked": gated, "detail": gate_reason},
            "score_floor": floor, "score": score, "coverage_percent": coverage,
            "signals": breakdown,
            "matching_required": [{"skill": x["skill"], "evidence": x["evidence"]} for x in r_rows if x["status"] != "missing"],
            "partial_required": [{"skill": x["skill"], "status": x["status"], "detail": x["detail"]}
                                 for x in r_rows if x["status"] in ("listed", "dated", "partial")],
            "missing_required": missing,
            "matching_preferred": [{"skill": x["skill"], "evidence": x["evidence"]} for x in p_rows if x["status"] != "missing"],
            "missing_preferred": [x["skill"] for x in p_rows if x["status"] == "missing"],
            "required_detail": r_rows, "preferred_detail": p_rows,
            "restrictions": restr[c.id],
        })
    results.sort(key=lambda r: (r["experience_gate"]["blocked"], -r["score_floor"], r["candidate_id"]))
    return {
        "job_id": job.id, "job_title": job.title,
        "label": "Internal recruiting match score. Not an objective measure; the recruiter decides.",
        "ranking": ("Candidates below the minimum experience are listed last. Otherwise ranked by score_floor "
                    "(points earned out of all weights; unknown signals count as zero). score is out of the "
                    "signals that had data; read it with coverage_percent."),
        "weights": weights, "weights_source": source,
        "recent_years_window": recent_years, "experience_gate_ratio": GATE_RATIO,
        "not_scored": [k for k in weights if k in NOT_SCORED],
        "candidates": results[:min(limit, 200)],
        "excluded": excluded,
    }