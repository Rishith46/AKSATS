from datetime import datetime, timezone

from fastapi import APIRouter, Depends, HTTPException, Query
from sqlalchemy import exists, false, func, select
from sqlalchemy.orm import Session

from app.deps import get_db, require_permission
from app.models.access import User
from app.models.candidates import (Candidate, CandidateExperience, CandidateSkill, Skill,
                                   SkillAlias)
from app.models.system import ActivityLog
from app.schemas.candidates import CandidateCreate, CandidateOut, CandidateUpdate
from app.visa import VISA_VALUES

router = APIRouter(prefix="/candidates", tags=["candidates"])

TRACKED = [
    "full_name", "email", "phone", "linkedin_url", "location", "visa_status",
    "rate", "total_experience_years", "status", "current_requirement", "recruiter_id",
]


def _snap(c: Candidate, fields=TRACKED) -> dict:
    return {f: (str(getattr(c, f)) if getattr(c, f) is not None else None) for f in fields}


def _log(db: Session, user: User, action: str, cid: int, old=None, new=None) -> None:
    db.add(ActivityLog(user_id=user.id, action=action, object_type="candidate",
                       object_id=cid, old_value=old, new_value=new))


def _get(db: Session, cid: int) -> Candidate:
    c = db.get(Candidate, cid)
    if not c:
        raise HTTPException(status_code=404, detail="Candidate not found")
    return c


@router.post("", response_model=CandidateOut, status_code=201)
def create_candidate(body: CandidateCreate, db: Session = Depends(get_db),
                     user: User = Depends(require_permission("candidate.edit"))):
    c = Candidate(**body.model_dump(), recruiter_id=user.id)
    db.add(c)
    db.flush()
    _log(db, user, "candidate.created", c.id, new=_snap(c))
    db.commit()
    db.refresh(c)
    return c


def _like(s: str) -> str:
    return "%" + s.strip().replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_") + "%"


@router.get("", response_model=list[CandidateOut])
def list_candidates(include_archived: bool = False, limit: int = 50, offset: int = 0,
                    q: str | None = None, location: str | None = None, title: str | None = None,
                    skill: list[str] = Query(default=[]), min_experience: float | None = None,
                    visa: str | None = None,
                    db: Session = Depends(get_db),
                    user: User = Depends(require_permission("candidate.view"))):
    stmt = select(Candidate).order_by(Candidate.id.desc())
    if not include_archived:
        stmt = stmt.where(Candidate.archived_at.is_(None))
    if q and q.strip():
        p = _like(q)
        stmt = stmt.where(Candidate.full_name.ilike(p, escape="\\")
                          | Candidate.email.ilike(p, escape="\\")
                          | Candidate.phone.ilike(p, escape="\\"))
    if location and location.strip():
        stmt = stmt.where(Candidate.location.ilike(_like(location), escape="\\"))
    if title and title.strip():
        stmt = stmt.where(exists().where(
            CandidateExperience.candidate_id == Candidate.id,
            CandidateExperience.title.ilike(_like(title), escape="\\")))
    for term in skill:
        t = term.strip().lower()
        if not t:
            continue
        ids = set(db.scalars(select(Skill.id).where(func.lower(Skill.name) == t)).all())
        ids |= set(db.scalars(select(SkillAlias.skill_id).where(func.lower(SkillAlias.alias) == t)).all())
        if not ids:
            stmt = stmt.where(false())
        else:
            stmt = stmt.where(exists().where(CandidateSkill.candidate_id == Candidate.id,
                                             CandidateSkill.skill_id.in_(ids)))
    if min_experience is not None:
        stmt = stmt.where(Candidate.total_experience_years >= min_experience)
    if visa:
        if visa not in VISA_VALUES:
            raise HTTPException(status_code=400, detail="visa must be one of: " + ", ".join(VISA_VALUES))
        stmt = stmt.where(Candidate.visa_status == visa)
    return db.scalars(stmt.limit(min(limit, 200)).offset(offset)).all()


@router.get("/{cid}", response_model=CandidateOut)
def get_candidate(cid: int, db: Session = Depends(get_db),
                  user: User = Depends(require_permission("candidate.view"))):
    return _get(db, cid)


@router.patch("/{cid}", response_model=CandidateOut)
def update_candidate(cid: int, body: CandidateUpdate, db: Session = Depends(get_db),
                     user: User = Depends(require_permission("candidate.edit"))):
    c = _get(db, cid)
    changes = body.model_dump(exclude_unset=True)
    fields = list(changes)
    old = _snap(c, fields)
    for k, v in changes.items():
        setattr(c, k, v)
    sources = dict(c.field_sources or {})
    for k in fields:
        if k not in ("status", "recruiter_id"):
            sources[k] = "confirmed"
    c.field_sources = sources
    db.flush()
    _log(db, user, "candidate.edited", c.id, old=old, new=_snap(c, fields))
    db.commit()
    db.refresh(c)
    return c


@router.post("/{cid}/archive", response_model=CandidateOut)
def archive_candidate(cid: int, db: Session = Depends(get_db),
                      user: User = Depends(require_permission("candidate.archive"))):
    c = _get(db, cid)
    if c.archived_at is not None:
        raise HTTPException(status_code=409, detail="Candidate is already archived")
    c.archived_at = datetime.now(timezone.utc)
    _log(db, user, "candidate.archived", c.id, old={"archived": False}, new={"archived": True})
    db.commit()
    db.refresh(c)
    return c


@router.post("/{cid}/restore", response_model=CandidateOut)
def restore_candidate(cid: int, db: Session = Depends(get_db),
                      user: User = Depends(require_permission("candidate.archive"))):
    c = _get(db, cid)
    if c.archived_at is None:
        raise HTTPException(status_code=409, detail="Candidate is not archived")
    c.archived_at = None
    _log(db, user, "candidate.restored", c.id, old={"archived": True}, new={"archived": False})
    db.commit()
    db.refresh(c)
    return c