from datetime import datetime
from decimal import Decimal

from pydantic import BaseModel, ConfigDict, EmailStr, Field
from typing import Annotated
from pydantic.functional_validators import AfterValidator

from app.visa import check_visa

Visa = Annotated[str | None, AfterValidator(check_visa)]


class CandidateCreate(BaseModel):
    full_name: str | None = Field(default=None, max_length=200)
    email: str | None = Field(default=None, max_length=255)
    phone: str | None = Field(default=None, max_length=50)
    linkedin_url: str | None = Field(default=None, max_length=500)
    location: str | None = Field(default=None, max_length=200)
    visa_status: Visa = Field(default=None, max_length=100)
    rate: Decimal | None = None
    total_experience_years: Decimal | None = None
    status: str = "New"
    current_requirement: str | None = Field(default=None, max_length=300)


class CandidateUpdate(BaseModel):
    full_name: str | None = Field(default=None, max_length=200)
    email: str | None = Field(default=None, max_length=255)
    phone: str | None = Field(default=None, max_length=50)
    linkedin_url: str | None = Field(default=None, max_length=500)
    location: str | None = Field(default=None, max_length=200)
    visa_status: Visa = Field(default=None, max_length=100)
    rate: Decimal | None = None
    total_experience_years: Decimal | None = None
    status: str | None = None
    current_requirement: str | None = Field(default=None, max_length=300)
    recruiter_id: int | None = None


class CandidateOut(BaseModel):
    model_config = ConfigDict(from_attributes=True)

    id: int
    full_name: str | None
    email: str | None
    phone: str | None
    linkedin_url: str | None
    location: str | None
    visa_status: str | None
    rate: Decimal | None
    total_experience_years: Decimal | None
    status: str
    current_requirement: str | None
    recruiter_id: int | None
    parse_status: str
    archived_at: datetime | None
    created_at: datetime
    updated_at: datetime